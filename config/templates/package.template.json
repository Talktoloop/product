{
  "name": "{{name}}",
  "version": "0.1.0",
  "private": true,
  "description": "Generated TypeScript types from the OpenAPI/Swagger specification",
  "packageManager": "yarn@4.2.2",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts"
    },
    "{{#apis}}": {
      "./{{outputDir}}": {
        "types": "./src/{{outputDir}}/index.d.ts"
      }
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ourloop/product-core-config": "*"
  },
  "devDependencies": {
    "typescript": "^5.3.3"
  }
}