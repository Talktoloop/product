{
  "name": "@ourloop/product-opt-package-generator",
  "version": "0.1.0",
  "private": true,
  "packageManager": "yarn@4.2.2",
  "type": "module",
  "scripts": {
    "generate:api-types": "tsx src/generate.ts",
    "generate:api-types:watch": "tsx watch src/generate.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ourloop/product-core-config": "*",
    "ajv": "^8.12.0",
    "handlebars": "^4.7.8",
    "openapi-typescript-codegen": "^0.25.0",
    "stjs": "^0.0.5"
  },
  "devDependencies": {
    "@types/node": "^20.11.19",
    "plop": "^4.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.3.3"
  },
  "inputs": [
    "src/**",
    "templates/**"
  ]
}
