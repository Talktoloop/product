FROM node:20

ARG env=development

# set working directory
RUN mkdir -p /usr/src/ourloop-ui
WORKDIR /usr/src/ourloop-ui

# add `/usr/src/app/node_modules/.bin` to $PATH
ENV PATH /usr/src/ourloop-ui/node_modules/.bin:$PATH

# copy dependency manifests + yarn config first (for layer caching)
COPY package.json yarn.lock .yarnrc.yml /usr/src/ourloop-ui/
COPY .yarn/releases /usr/src/ourloop-ui/.yarn/releases
COPY .yarn/plugins /usr/src/ourloop-ui/.yarn/plugins

# install dependencies using the bundled Yarn 3.1.1 via corepack
RUN corepack enable
RUN yarn install

# add app
COPY . /usr/src/ourloop-ui

ENTRYPOINT ["sh", "-c", "yarn install && yarn run start --host 0.0.0.0"]
