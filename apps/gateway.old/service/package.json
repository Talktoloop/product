{
  "name": "onz",
  "version": "0.0.40",
  "description": "gateway",
  "author": "elitecrew",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "rimraf dist && npx tsc -p tsconfig.build.json",
    "build-ci": "npx --package typescript tsc -p tsconfig.build.json",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "ts-node -r tsconfig-paths/register src/main.ts",
    "start:dev": "tsc-watch -p tsconfig.build.json --onSuccess \"node dist/main.js\"",
    "start:debug": "tsc-watch -p tsconfig.build.json --onSuccess \"node --inspect-brk dist/main.js\"",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest --testPathIgnorePatterns src/test/*.ts",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:integration": "NODE_ENV=test jest --config test/jest-integration.json --passWithNoTests --logHeapUsage --detectOpenHandles",
    "seeds": "node ./dist/seed/cli.js",
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js -d dist/config/typeorm.js",
    "typeorm:create": "cd ./src/migrations && ts-node -r tsconfig-paths/register ../../node_modules/typeorm/cli.js migration:create",
    "typeorm:generate": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:generate -f ./dist/config/typeorm.js -n",
    "typeorm:run": "yarn typeorm migration:run",
    "typeorm:revert": "yarn typeorm migration:revert",
    "check:dependencies": "depcheck",
    "start:debug:nodemon": "nodemon --config nodemon-debug.json"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.478.0",
    "@aws-sdk/client-comprehend": "^3.478.0",
    "@aws-sdk/client-lambda": "^3.478.0",
    "@cerbos/http": "^0.21.1",
    "@getbrevo/brevo": "^2.2.0",
    "@google-cloud/translate": "^8.0.2",
    "@nestjs/axios": "^3.0.1",
    "@nestjs/cache-manager": "^2.1.1",
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^10.3.0",
    "@nestjs/microservices": "^10.3.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/swagger": "^7.1.17",
    "@nestjs/throttler": "^5.1.1",
    "@nestjs/typeorm": "^10.0.1",
    "@ourloop/shared": "^1.0.74",
    "airtable-node": "^0.1.20",
    "axios": "^1.6.2",
    "axios-rate-limit": "^1.3.0",
    "body-parser": "^1.20.2",
    "cache-manager": "^5.3.2",
    "cache-manager-redis-store": "^2.0.0",
    "class-transformer": "^0.5.1",
    "cookie-parser": "^1.4.6",
    "crypto-js": "^4.2.0",
    "csurf": "^1.11.0",
    "date-fns": "^3.0.4",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "geoip-lite": "^1.4.9",
    "google-places-web": "^2.0.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "jwk-to-pem": "^2.0.5",
    "music-metadata": "^7.14.0",
    "mysql2": "^3.11.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "posthog-node": "^4.2.3",
    "reflect-metadata": "^0.2.1",
    "request-ip": "^3.3.0",
    "reverse-geocoding": "^3.0.2",
    "rimraf": "^5.0.5",
    "rxjs": "^7.8.1",
    "split-sms": "^0.1.7",
    "swagger-ui-express": "^5.0.0",
    "twilio": "^4.20.0",
    "typeorm": "^0.3.17",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@faker-js/faker": "^8.3.1",
    "@nestjs/cli": "^10.2.1",
    "@nestjs/schematics": "^10.0.3",
    "@nestjs/testing": "^10.3.0",
    "@types/airtable": "^0.10.1",
    "@types/cache-manager": "^4.0.6",
    "@types/cookie-parser": "^1.4.6",
    "@types/date-fns": "^2.6.0",
    "@types/express": "^4.17.21",
    "@types/helmet": "^4.0.0",
    "@types/jest": "^29.5.11",
    "@types/joi": "^17.2.3",
    "@types/jwk-to-pem": "^2.0.3",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.5",
    "@types/node-mailjet": "^3.3.12",
    "@types/supertest": "^2.0.16",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "depcheck": "^1.4.7",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "flat": "~5.0.2",
    "google-place-types": "^1.0.1",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.1",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsc-watch": "^6.0.4",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3"
  },
  "resolutions": {
    "airtable-node/**/node-fetch": "~2.6.1",
    "reverse-geocoding/**/debug": "~3.2.7",
    "reverse-geocoding/**/minimatch": "~3.0.5",
    "reverse-geocoding/**/tough-cookie": "~4.1.3",
    "reverse-geocoding/**/flat": "~5.0.1"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".spec.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
