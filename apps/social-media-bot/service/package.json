{
  "name": "onz",
  "version": "0.0.4",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json && nest build",
    "build-ci": "tsc -p tsconfig.build.json",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "ts-node -r tsconfig-paths/register src/main.ts",
    "start:dev": "nest build && tsc-watch -p tsconfig.build.json --onSuccess \"node dist/main.js\"",
    "start:debug": "tsc-watch -p tsconfig.build.json --onSuccess \"node --inspect-brk dist/main.js\"",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest --passWithNoTests --testPathIgnorePatterns src/test/*.ts",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:integration": "NODE_ENV=test jest --passWithNoTests --config test/jest-integration.json --runInBand",
    "check:dependencies": "depcheck"
  },
  "dependencies": {
    "@nestjs/bull": "^10.0.1",
    "@nestjs/cache-manager": "~2.1.1",
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^10.3.0",
    "@nestjs/microservices": "^10.3.0",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/swagger": "^7.1.17",
    "@nestjs/throttler": "^5.1.1",
    "@ourloop/shared": "^1.0.72",
    "body-parser": "^1.20.2",
    "bull": "^4.12.0",
    "cache-manager": "^5.3.2",
    "cache-manager-redis-store": "~2.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "cookie-parser": "^1.4.6",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "joi": "^17.11.0",
    "nestjs-i18n": "^10.4.0",
    "node-fetch": "2",
    "node-telegram-bot-api": "^0.64.0",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.0",
    "twilio": "^4.20.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.2.1",
    "@nestjs/testing": "~10.3.0",
    "@types/bull": "~3.15.9",
    "@types/cache-manager": "~4.0.6",
    "@types/express": "~4.17.21",
    "@types/jest": "29.5.11",
    "@types/joi": "~17.2.2",
    "@types/node": "~20.10.5",
    "@types/node-fetch": "^2.6.9",
    "@types/supertest": "~2.0.16",
    "@types/uuid": "~9.0.7",
    "@typescript-eslint/eslint-plugin": "~6.15.0",
    "@typescript-eslint/parser": "~6.15.0",
    "depcheck": "~1.4.7",
    "eslint": "~8.56.0",
    "eslint-config-prettier": "~9.1.0",
    "eslint-plugin-import": "~2.29.1",
    "jest": "~29.7.0",
    "prettier": "~3.1.1",
    "supertest": "~6.3.3",
    "ts-jest": "~29.1.1",
    "ts-loader": "~9.5.1",
    "ts-node": "~10.9.2",
    "tsc-watch": "~6.0.4",
    "tsconfig-paths": "~4.2.0",
    "typescript": "^5.3.3"
  },
  "resolutions": {
    "jackspeak": "2.1.1"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".spec.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
