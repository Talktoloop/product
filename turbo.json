{
  "$schema": "https://turborepo.org/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build",
        "^generate:api-types"
      ],
      "outputs": [
        "dist/**",
        ".nuxt/**"
      ]
    },
    "lint": {
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "cache": false
    },
    "prepare": {
      "dependsOn": [
        "^prepare"
      ],
      "outputs": [
        ".nuxt/**",
        ".playground/.nuxt/**"
      ],
      "cache": false
    },
    "clean": {
      "dependsOn": [
        "^clean"
      ]
    },
    "generate:api-types": {
      "cache": true,
      "outputs": [
        "core/api-types.generated/**"
      ],
      "inputs": [
        "config/api-types.json",
        "core/config/schema/api-types.schema.json",
        "core/config/api/TalkToLoop-swagger-spec.json",
        "config/templates/**/*"
      ]
    },
    "generate:api-types:watch": {
      "cache": false,
      "persistent": true
    }
  }
}