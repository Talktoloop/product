{
  "$schema": "https://turborepo.org/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".nuxt/**"
      ]
    },
    "lint": {
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "cache": false
    },
    "prepare": {
      "dependsOn": [
        "^prepare"
      ],
      "outputs": [
        ".nuxt/**",
        ".playground/.nuxt/**"
      ],
      "cache": false
    },
    "clean": {
      "dependsOn": [
        "^clean"
      ]
    }
  }
}