{
  "$schema": "https://turborepo.org/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build",
        "^generate:api-types"
      ],
      "outputs": [
        "dist/**",
        ".nuxt/**"
      ]
    },
    "lint": {
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "cache": false
    },
    "prepare": {
      "dependsOn": [
        "generate",
        "^prepare"
      ],
      "outputs": [
        ".nuxt/**",
        ".playground/.nuxt/**"
      ],
      "cache": false
    },
    "clean": {
      "dependsOn": [
        "^clean"
      ]
    },
    "build:bin": {
      "dependsOn": [
        "^build:bin"
      ],
      "cache": true,
      "outputs": [
        "dist/**"
      ]
    },
    "generate-package": {
      "dependsOn": [
        "build:bin",
        "^generate-package"
      ],
      "cache": true,
      "inputs": [
        "generate/*",
        "core/config/schema/*",
        "core/config/api/*"
      ]
    }
  }
}