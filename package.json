{
  "name": "@ourloop/product",
  "version": "0.1.0",
  "packageManager": "yarn@4.2.2",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "test": "turbo run test",
    "prepare": "turbo run prepare",
    "clean": "turbo run clean",
    "clean:locks": "rimraf .turbo *.lock"
  },
  "workspaces": [
    "opt/packages/*",
    "core/*",
    "layers/*",
    "apps/*"
  ],
  "devDependencies": {
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^15.11.0",
    "playwright-core": "^1.48.2",
    "prettier": "^3.3.3",
    "turbo": "^2.2.3",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "dependencies": {
    "rimraf": "^6.0.1"
  }
}