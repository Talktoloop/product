{
  "name": "@ourloop/product",
  "version": "0.1.0",
  "packageManager": "yarn@4.2.2",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "test": "turbo run test",
    "prepare": "husky && turbo run prepare",
    "clean": "turbo run clean",
    "clean:locks": "rimraf .turbo *.lock",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:staged": "lint-staged",
    "postinstall": "husky install"
  },
  "workspaces": [
    "core/*",
    "layers/*",
    "apps/*",
    "opt/packages/*"
  ],
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.15.0",
    "eslint-flat-config-utils": "^0.4.0",
    "eslint-preset-prettier": "^1.0.2",
    "happy-dom": "^15.11.0",
    "lint-staged": "^15.2.10",
    "playwright-core": "^1.48.2",
    "prettier": "^3.3.3",
    "turbo": "^2.2.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vitest": "^2.1.4"
  },
  "dependencies": {
    "husky": "^9.1.7",
    "rimraf": "^6.0.1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,vue}": [
      "eslint --fix ."
    ]
  }
}
